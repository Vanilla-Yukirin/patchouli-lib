PATCHOULI_ENVIRONMENT=development
PATCHOULI_DATABASE_URL=sqlite:///./data/patchouli.db
PATCHOULI_LOG_LEVEL=info
PATCHOULI_PORT=8765
# 生产环境必须设置 PATCHOULI_RETRIEVAL_CURSOR_SIGNING_SECRET（至少 32 字节）。
# 同时设置以下两个管理配置以启用面板，无需配置域名或 IP 白名单。
# 使用 patchouli-admin-password 生成 PATCHOULI_ADMIN_PASSWORD_HASH。
# PATCHOULI_ADMIN_PASSWORD_HASH=
# PATCHOULI_ADMIN_SESSION_SIGNING_SECRET=
# 仅在隔离、受信任的加密私网 HTTP 入口上显式启用；HTTPS Cookie 始终保留 Secure。
# PATCHOULI_ADMIN_ALLOW_PRIVATE_HTTP=false
# PATCHOULI_ADMIN_SESSION_TTL_SECONDS=1800
# HTTPS 代理转入 HTTP 后端时，填实际连接 API 的代理地址（容器网桥可能不是回环地址）。
# 只信任指定的直接代理，不使用 *；Compose 会传入此值供 Uvicorn 使用。
# FORWARDED_ALLOW_IPS=127.0.0.1
