PATCHOULI_ENVIRONMENT=development
PATCHOULI_DATABASE_URL=sqlite:///./data/patchouli.db
PATCHOULI_LOG_LEVEL=info
PATCHOULI_PORT=8765
# PATCHOULI_RETRIEVAL_CURSOR_SIGNING_SECRET is required in production (32+ bytes).
# Set all three admin values together to enable the optional web console.
# PATCHOULI_ADMIN_PASSWORD_HASH is generated by patchouli-admin-password.
# PATCHOULI_ADMIN_PASSWORD_HASH=
# PATCHOULI_ADMIN_SESSION_SIGNING_SECRET=
# PATCHOULI_ADMIN_ORIGIN=https://admin.example.invalid
# 仅在隔离、受信任的加密私网入口上显式启用；同时设置精确的 HTTP IP Origin。
# PATCHOULI_ADMIN_ALLOW_PRIVATE_HTTP=false
# PATCHOULI_ADMIN_SESSION_TTL_SECONDS=1800
