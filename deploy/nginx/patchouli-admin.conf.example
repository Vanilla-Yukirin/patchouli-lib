# Target-neutral Nginx example for a TLS entry point in front of the loopback API.
# Replace the example server name and certificate locations only in private
# operator configuration. This file belongs inside Nginx's `http` context.

limit_req_zone $binary_remote_addr zone=patchouli_admin_login:10m rate=5r/m;

upstream patchouli_api {
    server 127.0.0.1:8765;
    keepalive 16;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name admin.example.invalid;

    ssl_certificate /operator-managed/tls/fullchain.pem;
    ssl_certificate_key /operator-managed/tls/private-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /admin/login {
        client_max_body_size 16k;
        limit_req zone=patchouli_admin_login burst=3 nodelay;
        proxy_pass http://patchouli_api;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location = /admin {
        client_max_body_size 16k;
        proxy_pass http://patchouli_api;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location ^~ /admin/ {
        client_max_body_size 16k;
        proxy_pass http://patchouli_api;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        client_max_body_size 2304k;
        proxy_pass http://patchouli_api;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
